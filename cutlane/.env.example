# ─────────────────────────────────────────────────────────────────────────────
# CutLane environment variables.
# Copy to .env.local and fill in. NEVER commit real values.
# Every integration switches from DEMO (mock) to LIVE on its own as soon as its
# variables are present — see /status in the app for what is live right now.
# All of these are read on the server only. None are exposed to the browser
# (there are no NEXT_PUBLIC_ variables in this app on purpose).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this app (used for cookies and redirects).
APP_URL=http://localhost:3000

# ── Whop (Sign in with Whop + bounties + submissions) ────────────────────────
# Developer Dashboard → your app → OAuth. Redirect URI must match exactly.
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_REDIRECT_URI=http://localhost:3000/api/auth/whop/callback
# Optional. Space-separated OAuth scopes. Add the bounty read / submission
# create scopes your app is granted in the Whop dashboard (open question #2).
WHOP_OAUTH_SCOPES=openid profile email
# Optional. Pins Whop REST calls to a dated API version.
WHOP_API_VERSION_DATE=2026-11-13

# ── YouTube Data API v3 (research — reference only, no downloads) ────────────
YOUTUBE_API_KEY=

# ── Supabase (Postgres + Storage for uploaded clips) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for server-side SQL (Supabase → Project Settings →
# Database → Connection string, "Transaction pooler"). When empty, CutLane uses
# a local embedded Postgres (PGlite) in ./.data so every screen still works.
DATABASE_URL=
# Storage bucket for clips (created automatically if missing, private).
SUPABASE_CLIPS_BUCKET=clips

# ── Stripe billing ───────────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY + STRIPE_PRICE_BEGINNER, billing runs in TEST MODE:
# simulated checkout, no charges, and buttons on /billing to simulate Stripe events.
# Use sk_test_… keys first. Prices: recurring monthly USD prices in your Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BEGINNER=
STRIPE_PRICE_CLIPPER=
# Feature flag: annual billing (2 months free). Needs the annual price IDs below.
BILLING_ANNUAL_ENABLED=false
STRIPE_PRICE_BEGINNER_ANNUAL=
STRIPE_PRICE_CLIPPER_ANNUAL=
# Feature flag: Clipper checkout + V2 features. Keep false until the editor/auto-post ship
# (Clipper shows "Coming soon" with a waitlist and is never charged while false).
CLIPPER_AVAILABLE=false

# ── Sales email (Contact sales form) ─────────────────────────────────────────
# Leads are always saved to the database; email is sent only when both are set.
RESEND_API_KEY=
SALES_NOTIFY_EMAIL=
# Must be a sender on a domain you verified in Resend.
SALES_FROM_EMAIL=CutLane <sales@cutlane.io>

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated Whop user IDs (user_…) allowed to open /admin and assign Custom plans.
ADMIN_WHOP_USER_IDS=

# ── Legal pages (/terms, /privacy) ───────────────────────────────────────────
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Protects /api/cron/youtube-retention (daily refresh/expiry of stored YouTube data, required by
# the YouTube API policy). Vercel Cron sends it automatically; other schedulers send
# "Authorization: Bearer <CRON_SECRET>". Generate with: npm run keygen
CRON_SECRET=

# ── Demo / staging ───────────────────────────────────────────────────────────
# In a production build, demo sign-in, mock data, simulated billing, the local database and local
# file storage are OFF and the server refuses to start with missing configuration.
# Set to true ONLY for a staging/review deploy (and for running the e2e tests locally).
ALLOW_DEMO=false

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: npm run keygen
# Encrypts Whop tokens at rest (AES-256-GCM) and signs session/upload tokens.
# Required as soon as Whop is live.
TOKEN_ENCRYPTION_KEY=
