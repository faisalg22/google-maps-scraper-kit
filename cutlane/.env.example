# ─────────────────────────────────────────────────────────────────────────────
# CutLane environment variables.
# Copy to .env.local and fill in. NEVER commit real values.
# Every integration switches from DEMO (mock) to LIVE on its own as soon as its
# variables are present — see /status in the app for what is live right now.
# All of these are read on the server only. None are exposed to the browser
# (there are no NEXT_PUBLIC_ variables in this app on purpose).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this app (used for cookies and redirects).
APP_URL=http://localhost:3000

# ── Whop (Sign in with Whop + bounties + submissions) ────────────────────────
# Developer Dashboard → your app → OAuth. Redirect URI must match exactly.
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_REDIRECT_URI=http://localhost:3000/api/auth/whop/callback
# Optional. Space-separated OAuth scopes. Add the bounty read / submission
# create scopes your app is granted in the Whop dashboard (open question #2).
WHOP_OAUTH_SCOPES=openid profile email
# Optional. Pins Whop REST calls to a dated API version.
WHOP_API_VERSION_DATE=2026-11-13

# ── YouTube Data API v3 (research — reference only, no downloads) ────────────
YOUTUBE_API_KEY=

# ── Supabase (Postgres + Storage for uploaded clips) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for server-side SQL (Supabase → Project Settings →
# Database → Connection string, "Transaction pooler"). When empty, CutLane uses
# a local embedded Postgres (PGlite) in ./.data so every screen still works.
DATABASE_URL=
# Storage bucket for clips (created automatically if missing, private).
SUPABASE_CLIPS_BUCKET=clips

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: npm run keygen
# Encrypts Whop tokens at rest (AES-256-GCM) and signs session/upload tokens.
# Required as soon as Whop is live.
TOKEN_ENCRYPTION_KEY=
